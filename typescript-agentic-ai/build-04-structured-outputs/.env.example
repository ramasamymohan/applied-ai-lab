
# Model provider credentials — backend only
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=replace_with_your_model_name

# API server
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# PostgreSQL — required (Build 03 onward)
DATABASE_URL=postgresql://localhost:5432/storefront_ai

# Context window — number of completed turns sent to the model (default: 10)
MAX_CONTEXT_TURNS=10

# Structured generation (Build 04)
# Model for structured calls; must support strict structured outputs.
# Defaults to OPENAI_MODEL when unset.
# STRUCTURED_OUTPUT_MODEL=
# Per-call timeout in ms (default: 15000). A repair retry can double the worst case.
STRUCTURED_OUTPUT_TIMEOUT_MS=15000
# Output token cap for structured calls (default: 512). Truncated output is rejected.
STRUCTURED_OUTPUT_MAX_TOKENS=512
# Allow one repair retry after a parse/validation failure: true | false (default: true)
STRUCTURED_OUTPUT_REPAIR_ENABLED=true
